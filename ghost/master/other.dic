MakePatternSurfaces : all
{
	_max = _argv[0]
	if _max <= 0; return
	
	_surface = 10002
	_image = 1000
	for _i = 0; _i < _max; _i++
	{
		"surface%(_surface)"
		"CRLF"
		"{"
		"CRLFTAB"
		"element0,overlay,surface502.png,0,0"
		"CRLFTAB"
		"element1,overlayfast,tie_patterns/surface%(_image).png,580,373"
		"CRLF"
		"}"
		"CRLFCRLF"
		_surface++
		"surface%(_surface)"
		"CRLF"
		"{"
		"CRLFTAB"
		"element0,overlay,surface503.png,0,0"
		"CRLFTAB"
		"element1,overlayfast,tie_patterns/surface%(_image).png,570,313"
		"CRLF"
		"}"
		"CRLFCRLF"
		_surface += 9
		_image++
	}
}

MakePatternBinds : all
{
	_max = _argv[0]
	if _max <= 0; return
	
	_surface = 10002
	_image = 1000
	for _i = 0; _i < _max; _i++
	{
		"TAB"
		"animation%(_image).interval,bind"
		"CRLFTAB"
		"animation%(_image).pattern0,overlay,%(_surface),0,0,0"
		"CRLFTAB"
		"animation%(_image).option,background"
		"CRLF"
		"CRLF"
		
		
		_image++
		_surface += 10
	}
	"CRLFCRLFCRLFCRLFCRLF"
	_surface = 10003
	_image = 1000
	for _i = 0; _i < _max; _i++
	{
		"TAB"
		"animation%(_image).interval,bind"
		"CRLFTAB"
		"animation%(_image).pattern0,overlay,%(_surface),0,0,0"
		"CRLFTAB"
		"animation%(_image).option,background"
		"CRLF"
		"CRLF"
		
		_image++
		_surface += 10
	}
}

MakePatternDescripts : all
{
	_max = _argv[0]
	if _max <= 0; return
	
	_num = 1000
	for _i = 0; _i < _max; _i++
	{
		"sakura.bindgroup%(_num).name,Tie,%(_num)"
		"CRLF"
		_num++
	}
}