/*
	Possible intents:
	
	growl
	hiss
	screaming
	excited
	interested
	stressed
	thoughtful
	confused
	inquisitive
	hesitant
	repeating
	soft
	loud
	long
	short
	one word
	definitive
	demanding
	
	Repeated letter reference:
	
	aaa - screaming
	eee - excited (also triggered by multiple scattered !s)
	ooo - interested
	hhh - stressed
	mmm - thoughtful
	sss - hiss (also triggered by multiple scattered Hs)
	rrr - growl (also triggered by multiple scattered Gs)
	?? - confused
*/

//User's response to Boss asking a question
OnAnswerQuestion
{
	_input = TOLOWER(reference0)
	_type = TOAUTO(reference.raw[0])
	_intents = ProcessQuestion(reference0)
	
	LOGGING("====================================================================")
	LOGGING("_input: %(_input)")
	LOGGING("_intents: %(_intents)")
	//This can be set up like the if/else structure in OnAskQuestion below
	if _input == ""
	{
		"\0\b[4]%(forward)%(paper)Oh, %(DragonNoiseSuffix), %(nervous)%(paper)nothing to say... oh no..."
	}
	elseif GETTYPE(_type) == 1 || GETTYPE(_type) == 2 //If the response is a number, with or without decimal point
	{
		"\0\b[4]%(processing)%(paper)Hmmm. \w8\w8%(ceiling)%(paper)Sounds like real number..."
	}
	elseif Intent("soft,growl",_intents)
	{
		"\0\b[4]%(processing)%(neutral)%(DragonNoisePrefix)...? \n\n%(look)%(neutral)%(DragonNoisePrefix)%(DragonNoiseSuffix)%(DragonNoiseSuffix)%(DragonNoiseSuffix)%(DragonNoiseSuffix)..."
	}
	elseif Intent("screaming,loud",_intents)
	{
		"\0\b[4]%(ceiling)%(neutral)AAAAAAAAAA%(pet)%(neutral)AAAAAAAAAA%(ceiling)%(neutral)AAAAAAAAAA%(pet)%(neutral)AAAAAAAAAA %(forward)%(neutral)\w8WHY WE SCREAMING?\w8 %(ceiling)%(neutral)AAAAAAAAAA%(pet)%(neutral)AAAAAAAAAA%(ceiling)%(neutral)AAAAAAAAAA%(pet)%(neutral)AAAAAAAAAA"
	}
	elseif "gold" _in_ _input
	{
		"\0\b[4]%(forward)%(agitated)Gold!!! %(serious)%(agitated)My gold!!! %(threaten)%(agitated)Give!!! No one touch!!!"
	}
	elseif Intent("hesitant",_intents)
	{
		"\0\b[4]%(serious)%(paper)Hmm, not con-\w4fi-\w4dent, I see..."
	}
	elseif Intent("excited",_intents)
	{
		"\0\b[4]%(happy)%(agitated)Yes yes yes good good good, good en-\w4thu-\w4si-\w4as-\w4m!"
	}
	elseif Intent("inquisitive",_intents)
	{
		"\0\b[4]%(smile)%(paper)Want to know more, yes? Yes. %(read)%(paper)We go over this more."
	}
	elseif Intent("thoughtful",_intents)
	{
		"\0\b[4]%(forward)%(neutral)I see, I see. %(smile)%(neutral)Thinking care-\w4ful-\w4ly. Good."
	}
	elseif Intent("confused",_intents)
	{
		"\0\b[4]%(serious)%(paper)Grmm... Seem confused... %(nervous)%(paper)Maybe I not ask well enough...?"
	}
	elseif Intent("loud",_intents)
	{
		"\0\b[4]%(nervous)%(paper)WHY YELL? %(ceiling)%(paper)WHY YELL!"
	}
	elseif Intent("long",_intents)
	{
		"\0\b[4]%(forward)%(tie)Many words... Grrm... %(nervous)%(tie)You... Say again? Did not hear all..."
	}
	elseif Intent("one word",_intents)
	{
		"\0\b[4]%(nervous)%(neutral)Creature of few words...?"
	}
	elseif Intent("short",_intents)
	{
		"\0\b[4]%(forward)%(speak)Concise, I see. ... %(nervous)%(tie)What does mean...?"
	}
	else //Didn't match any intents
	{
		"\0\b[4]%(squint)%(tie)I see... %(nervous)%(tie)I not see."
	}
}

//Resoponses to yes/no questions
OnAnswerYesNo
{
	"\0\b[0]"
	--
	if reference1 == "worked with dragon"
	{
		if reference0 == "yes"
		{
			"\0\b[4]%(threaten)%(agitated)WHAT!? %(wings)WERE THEY BIGGER THAN ME!?%(yesno('bigger than me'))"
		}
		else
		{
			"\0\b[4]%(processing)%(neutral)Oh, good. %(pet)%(speak)I would hate to have dragonly competition!"
		}
	}
	elseif reference1 == "bigger than me"
	{
		if reference0 == "yes"
		{
			"\0\b[0]%(threaten)%(agitated)%(wings)WHAT!? NO NO NO! BITE BITE GRRR CLAW BITE THEM!!! MINE MINE MINE- \n\n... \n\n\0%(threaten)%(agitated)grrrm... %(tired)%(neutral)\w8\w8\w8\w8%(serious)%(neutral)Apologies. I... %(nervous)%(neutral)got carried away."
		}
		else
		{
			"\0\b[4]%(serious)%(neutral)Ah. %(processing)%(neutral)I see. %(smile)%(neutral)That's fine then. \n\n%(italic)%(narration)...\w8 He seems happy about that,\w4 for some reason... %(italicoff)"
		}
	}
	elseif reference1 == "caught stealing"
	{
		if reference0 == "yes"
		{
			"\0\b[0]%(serious)%(neutral)Yes? You said... %(threaten)%(agitated)you said yes!? Ad said no thieves! THIEVES MEANS NO THIEVES!!! \n\n%(wings)YOU AFTER MY GOLD!? MY CAVE!? MY TIES!?!?!?%(yesno('after my ties'))"
		}
		else
		{
			GenericPositive
		}
	}
	elseif reference1 == "after my ties"
	{
		if reference0 == "yes"
		{
			"\0\b[2]%(threaten)%(agitated)%(wings)NO! NO! OUT MY CAVE! NO JOB! FIRED! FIRED FIRED FIRED!!! NO THANK YOU! GOODBYE! \n\n%(italic)%(narration)Uh-oh, this is getting pretty dangerous. \n\n%(narration)You decide to leave... \n\n%(narration)Maybe you should have kept your criminal history to yourself when dealing with a giant carnivorous lizard... \n\n%(narration)Oh well. Back to job hunting. \w8\w8\w8\w8\w8\w8\![vanishbymyself]"
		}
		else
		{
			"\0\b[0]%(threaten)%(agitated)%(DragonNoisePrefix)... Grrm... Don't know if I trust you... \w8\w8\w8\n\n%(scowl)%(neutral)Okay... Okay. I'll give you chance. I see any funny business, you gone. Gone forever, or else. \n\nOkay?%(yesno('no funny business'))"
		}
	}
	elseif reference1 == "no funny business"
	{
		if reference0 == "yes"
		{
			GenericPositive
		}
		else
		{
			"\0\b[0]%(threaten)%(agitated)%(DragonNoisePrefix)... I think... You not taking this opportunity seriously... Making jokes... Making me %(wings)UPSET... \w8\w8\n\n%(threaten)%(agitated)Let's move on... \n\n... before one of us does something they regret."
		}
	}
	elseif reference1 == "work a microwave"
	{
		if reference0 == "yes"
		{
			"\0\b[4]%(plead)%(neutral)Can you teach me?%(yesno('yes'))"
		}
		else
		{
			"\0\b[4]%(tired)%(neutral)Me neither... %(look)%(neutral)Need more kobolds..."
		}
	}
	
	//Generic responses
	elseif reference0 == "yes"
	{
		if reference1 == "yes"; GenericPositive(reference0)
		elseif reference1 == "no"; GenericNegative(reference0)
		else; GenericNeutral(reference0)
	}
	else //no
	{
		if reference1 == "no"; GenericPositive(reference0)
		elseif reference1 == "yes"; GenericNegative(reference0)
		else; GenericNeutral(reference0)
	}
}

GenericNeutral
{
	"\0\b[4]%(scowl)%(neutral)I see, I see..."
	"\0\b[4]%(scowl)%(neutral)Good in-\w4for-\w4ma-\w4tion..."
	"\0\b[4]%(read)%(paper)Hmm... %(forward)%(paper)I see? %(nervous)%(paper) I see!"
}

GenericPositive : pool
{
	_opposite = "no"
	if _argv[0] == "no"; _opposite = "yes"
	
	"\0\b[4]%(smile)%(neutral)Oh, good good good good. %(happy)%(agitated)Yes, very good to know about %(name)!"
	"\0\b[4]%(smile)%(neutral)Good! %(forward)%(neutral)Good good good. Good to know. %(forward)%(speak)Important, you know."
	if _argv[0] == "yes" || _argv[0] == "no"
	{
		"\0\b[4]%(forward)%(speak)Ex-\w4cel-\w4lent! %(nervous)%(tie)Would be bad if %(_opposite)."
	}
}

GenericNegative
{
	"\0\b[4]%(scowl)%(paper)Hmm, this concerning..."
	"\0\b[4]%(squint)%(paper)I see... %(serious)%(paper)Reconsider."
}

















//Boss's response to the user asking a question
OnAskQuestion
{
	_intents = ProcessQuestion(reference0)
	_input = TOLOWER(reference0)
	
	//The top line here and the line at the bottom can be commented if you want to get rid of the debug info
	if _input == ""
	{
		"\0\b[4]%(forward)%(paper)Oh, %(DragonNoiseSuffix), %(nervous)%(paper)nothing to say... Oh..."
	}
	elseif Intent("soft,growl",_intents)
	{
		"\0\b[4]%(processing)%(neutral)%(DragonNoisePrefix)...? \n\n%(look)%(neutral)%(DragonNoisePrefix)%(DragonNoiseSuffix)%(DragonNoiseSuffix)%(DragonNoiseSuffix)%(DragonNoiseSuffix)..."
	}
	elseif Intent("screaming,loud",_intents)
	{
		"\0\b[4]%(ceiling)%(neutral)AAAAAAAAAA%(pet)%(neutral)AAAAAAAAAA%(ceiling)%(neutral)AAAAAAAAAA%(pet)%(neutral)AAAAAAAAAA %(forward)%(neutral)\w8WHY WE SCREAMING?\w8 %(ceiling)%(neutral)AAAAAAAAAA%(pet)%(neutral)AAAAAAAAAA%(ceiling)%(neutral)AAAAAAAAAA%(pet)%(neutral)AAAAAAAAAA"
	}
	elseif "gold" _in_ _input
	{
		"\0\b[4]%(forward)%(agitated)Gold!!! %(serious)%(agitated)My gold!!! %(threaten)%(agitated)Give!!! No one touch!!!"
	}
	elseif "require" _in_ _input
	{
		"\0\b[0]%(forward)%(speak)The only requirements are counting treasure, %(squint)%(neutral)cleaning treasure, %(scowl)%(neutral)protecting treasure, and %(threaten)%(agitated)NOT STEALING TREASURE."
	}
	elseif "time off" _in_ _input
	{
		"\0\b[0]%(forward)%(paper)Under my management, %(smile)%(paper)you'll get 2 full days off every month, as well as all of the usual holidays: %(ceiling)%(paper)the Decennial Hibernation, my birthday, Livestock Roasting Day, laundry day..."
	}
	elseif "your birthday" _in_ _input
	{
		"\0\b[4]%(forward)%(tie)My birthday? %(happy)%(agitated)May 18th, of course!"
	}
	elseif "accidental death" _in_ _input
	{
		"\0\b[4]%(smile)%(neutral)Don't worry! %(smile)%(tie)I've never had employee die on my watch before! \n\n%(italic)%(narration)Has he ever had any employees before...? %(italicoff)"
	}
	elseif "salary" _in_ _input && "negotiable" _in_ _input
	{
		"\0\b[0]%(serious)%(tie)Grrm... what do you want to be paid in? %(processing)%(speak)Scales? %(smile)%(neutral)Meat? %(look)%(neutral)Stickynotes? %(read)%(paper)Silver? \n\n%(serious)%(paper)If you do well, we can figure something out."
	}
	else //Didn't match any intents
	{
		"\0\b[4]%(squint)%(tie)Hmm, I see I see... %(forward)%(neutral)I will consider this. Get back to you later."
		"\0\b[4]%(processing)%(neutral)Um... yes. %(ceiling)%(neutral)Yes? %(forward)%(neutral)Yes."
		"\0\b[4]%(processing)%(neutral).\w8.\w8.\w8\w8\w8\w8\w8 %(nervous)%(tie) Prob-\w4ab-\w4ly?"
	}
}

OnUserInputCancel
{
	if reference1 == "timeout"
	{
		timeoutresponse
	}
	else //closed deliberately
	{
		if reference0 == "OnAskQuestion"
		{
			OnCancelQuestion
		}
		else
		{
			"\0\b[4]%(scowl)%(paper)Hmmm, refusing to answer..."
			"\0\b[4]%(scowl)%(paper)A-\w4voi-\w4ding question..."
			"\0\b[4]%(serious)%(paper)I see, you refuse..."
			"\0\b[4]%(serious)%(paper)Ig-\w4nor-\w4ing question..."
		}
	}
}

OnChoiceTimeout
{
	if "OnAnswerYesNo" _in_ reference0
	{
		"\![close,inputbox,OnAnswerQuestion]"
		--
		timeoutresponse
	}
}

timeoutresponse
{
	"\0\b[4]%(scowl)%(paper)Okay, %(forward)%(neutral)we come back to that."
	"\0\b[4]%(scowl)%(paper)Hm, not sure...? %(forward)%(neutral)I ask again later."
	--
	"\_w[2000]"
}