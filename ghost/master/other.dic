they
{
	if SHIORI3FW.UserSex == "male"; "he"
	elseif SHIORI3FW.UserSex == "female"; "she"
	else; "they"
}

them
{
	if SHIORI3FW.UserSex == "male"; "him"
	elseif SHIORI3FW.UserSex == "female"; "her"
	else; "them"
}

their
{
	if SHIORI3FW.UserSex == "male"; "his"
	elseif SHIORI3FW.UserSex == "female"; "her"
	else; "their"
}

theirs
{
	if SHIORI3FW.UserSex == "male"; "his"
	elseif SHIORI3FW.UserSex == "female"; "hers"
	else; "theirs"
}

themself
{
	if SHIORI3FW.UserSex == "male"; "himself"
	elseif SHIORI3FW.UserSex == "female"; "herself"
	else; "themself"
}

//%(they) %(p('are','is'))
//You can change the name of this function if you want! I kept it short so it's fast to type
p
{
	if SHIORI3FW.UserSex == "undef"; _argv[0] //they are
	else; _argv[1] //he is/she is
}

/*

An example of the above setup:
"%(they) %(p('were','was')) looking for that earlier, I'll ask if %(they)'%('ve','s') found it."

If using they, the %(p) functions will return the first word specified, resulting in:
"they were looking for that earlier, I'll ask if they've found it."

If not using they, for example if using she, it will return the second specified word instead, resulting in:
"she was looking for that earlier, I'll ask if she's found it."

With this function, you can quickly customize words that need to change based on whether it should be singular or plural. Just remember; the %(p) function is set up so that the first word you specify matches with the 'they' labels used on the pronoun functions. You can always switch that around if you like, too.

*/

//why didn't i do this in the first place tho........
username
{
	SHIORI3FW.UserName
}

Capitalize
{
	_f = TOUPPER(SUBSTR(_argv[0],0,1))
	_l = SUBSTR(_argv[0],1,STRLEN(_argv[0]))
	_f + _l
}

//Sorry I am not going to try to deal with letter hats for this. Also sorry Y you're a consonant here
IsVowel
{
	case TOLOWER(_argv[0])
	{
		when "a", "e", "i", "o", "u"; 1
		others; 0
	}
}

input : all
{
	if _argv[0] != "firstboot"; "\_l[-10000]\q[timeoutprevention,OnAnswerYesNo]\_l[0,0]"
	
	"\![set,choicetimeout,%(aitalkinterval * 1000)]\![open,inputbox,OnAnswerQuestion,-1,--balloon=__INPUT%(C_BYTE1)BALLOON__,--reference=%(_argv[0])]"
}

yesno : all
{
	"\_q\n\n\![*]\q[Yes,OnAnswerYesNo,yes,%(_argv[0])]"
	"\n \n[-100]\f[align,right]"
	"\![*]\q[No,OnAnswerYesNo,no,%(_argv[0])]"
	"\![set,choicetimeout,%(aitalkinterval * 1000)]"
}

multiplechoice : all
{
	_id = _argv[0]
	_argv[0] = IARRAY
	
	"\_q\n\n"
	foreach _argv; _arg
	{
		_response = "neutral"
		if SUBSTR(_arg,0,1) == "+"
		{
			_response = "positive"
			_arg = ERASE(_arg,0,1)
		}
		elseif SUBSTR(_arg,0,1) == "-"
		{
			_response = "negative"
			_arg = ERASE(_arg,0,1)
		}
		"\![*]\q[%(_arg),OnAnswerMultipleChoice,%(_id),%(_arg),%(_response)]\n"
	}
}

//\![open,sliderinput,(ID),(display time),(current value),(minimum),(maximum),(option)]
agreeslider
{
	_name = _argv[0]
	_num = 2
	if _argv[1] != ""; _num = TOINT(_argv[1]) - 1
	
	_thresholds = (50)
	if _num == 2; _thresholds = (33,66)
	if _num == 3; _thresholds = (25,50,75)
	elseif _num == 4; _thresholds = (20,40,60,80)
	
	_preferred = _argv[2]
	
	"\![open,sliderinput,OnAnswerAgreeSlider,-1,50,0,100,--reference=""%(_name)"",--reference=""%(_thresholds)"",--reference=""%(_preferred)""]"
}

amountslider
{
	_name = _argv[0]
	_bottom = 1
	_top = 100
	if _argv[1] != ""
	{
		_bottom = TOINT(_argv[1][0])
		_top = TOINT(_argv[1][1])
	}
	_thresholds = "33,66"
	if _argv[1] != ""; _thresholds = _argv[1]
	_preferred = _argv[2]
	
	_middle = ((_top - _bottom) / 2) + _bottom
	
	"\![open,sliderinput,OnAnswerAmountSlider,-1,%(_middle),%(_bottom),%(_top),--reference=""%(_name)"",--reference=""%(_thresholds)"",--reference=""%(_preferred)""]"
}

DetermineSliderResponse
{
	_answer = _argv[0]
	_middle = TOINT(_argv[1])
	_argv[0] = IARRAY
	_argv[0] = IARRAY
	_thresholds = SPLIT(_argv,",")
	for _i = 0; _i < ARRAYSIZE(_thresholds); _i++
	{
		_thresholds[_i] = TOINT(_thresholds[_i])
	}
	_count = ARRAYSIZE(_thresholds)
	
	_response = "medium"
	if _answer == _middle; _response = "medium" //It's awkward if you don't move the slider at all and the response isn't neutral
	elseif _count == 1
	{
		if _answer > _thresholds[0]; _response = "high"
		else; _response = "low"
	}
	elseif _count == 2
	{
		if _answer > _thresholds[1]; _response = "high"
		elseif _answer > _thresholds[0]; _response = "medium"
		else; _response = "low"
	}
	elseif _count == 3
	{
		if _answer > _thresholds[2]; _response = "very high"
		elseif _answer > _thresholds[1]; _response = "high"
		elseif _answer > _thresholds[0]; _response = "low"
		else; _response = "very low"
	}
	elseif _count == 4
	{
		if _answer > _thresholds[3]; _response = "very high"
		elseif _answer > _thresholds[2]; _response = "high"
		elseif _answer > _thresholds[1]; _response = "medium"
		elseif _answer > _thresholds[0]; _response = "low"
		else; _response = "very low"
	}
	//More than that and you'll have to do it custom
	_response
}

interviewscore
{
	if TotalResponses > 10
	{
		if PositiveResponses - NegativeResponses > 10
		{
			"positive"
			return
		}
		elseif NegativeResponses - PositiveResponses > 10
		{
			"negative"
			return
		}
	}
	"neutral"
}

name
{
	_name = TempNames
	if NameDiscovered
	{
		_name = CurrentName
		"\_a[OnQuestionName]%(_name)\_a"
	}
	else; _name
}

an
{
	_word = _argv[0]
	_vowels = ("a","e","i","o","u")
	foreach _vowels; _vowel
	{
		if StartsWith(_word,_vowel)
		{
			"an %(_word)"
			return
		}
	}
	"a %(_word)"
}

//Searches the start of a string for the requested substring.
//Argument 0 is the source string to search, argument 1 is the substring to search for.
//Returns 1 if true, 0 if false.
//Usage example:
//StartsWith("Testing","Test")
StartsWith
{
	SUBSTR(_argv[0],0,STRLEN(_argv[1])) == _argv[1]
}

//Searches the end of a string for the requested substring.
//Argument 0 is the source string to search, argument 1 is the substring to search for.
//Returns 1 if true, 0 if false.
//Usage example:
//EndsWith("Testing","ing")
EndsWith
{
	_len = STRLEN(_argv[1])
	SUBSTR(_argv[0],STRLEN(_argv[0]) - _len,_len) == _argv[1]
}

OnQuestionName
{
	_index = NameIndex
	if SavedUsername != username //New name
	{
		NameIndex = 7
		SavedUsername = username
		ProgressMangler
		
		"\0\b[0]%(processing)%(paper)Oh? Name changed? %(read)%(paper)Ok! Let me see here, %(squint)%(paper)it's... \n\n... %(read)%(paper)%(CurrentName)! Yes! %(forward)%(neutral)Call you %(CurrentName) from now on. %(happy)%(agitated)Good sound."
	}
	elseif NameIndex > 0
	{
		ProgressMangler
		
		if _index == 1 //Saying it right for the first time
		{
			"\0\b[0]%(processing)%(paper)%(CurrentName)? %(smile)%(neutral)%(CurrentName)! %(happy)%(agitated)%(CurrentName) %(CurrentName) %(CurrentName) %(CurrentName) %(CurrentName)~!!"
		}
		elseif _index == 6
		{
			//"\0\b[4]%(neutral)%(forward)Oh. %(nervous)%(tie)Say name wrong...? %(squint)%(paper)It's... Ah! %(pet)%(neutral)It's %(CurrentName)! %(forward)%(neutral)I get it right now."
			"\0\b[4]%(look)%(paper)What? %(squint)%(paper)What??? %(scowl)%(paper)You say... %(CurrentName)? %(processing)%(paper)Grrm..."
		}
		else //Getting it wrong in a new way
		{
			"\0\b[4]%(processing)%(paper)Oh oh, okay! %(smile)%(neutral)I got it, it's %(CurrentName). %(forward)%(neutral)Yes, sure this time."
		}
	}
	elseif NameIndex == 0 //Already had it right
	{
		"\0\b[4]%(smile)%(paper)Yes yes, I remember, %(CurrentName)! %(happy)%(agitated)%(CurrentName) %(CurrentName) %(CurrentName)~"
	}
	--
	"\_w[2000]"
}

OnNotifyDressupInfo
