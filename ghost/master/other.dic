}

SliderAgree.GenericNegative
{
	"hmm, concerning"
}

SliderAgree.GenericVeryNegative
{
	"NO! BAD BAD! GRRR BITE BITE BAD FIRED"
}

amountslider
{
	_name = _argv[0]
	_bottom = 1
	_top = 100
	if _argv[1] != ""
	{
		_bottom = TOINT(_argv[1][0])
		_top = TOINT(_argv[1][1])
	}
	_thresholds = "33,66"
	if _argv[1] != ""; _thresholds = _argv[1]
	_preferred = _argv[2]
	
	_middle = ((_top - _bottom) / 2) + _bottom
	
	"\![open,sliderinput,OnAnswerAmountSlider,-1,%(_middle),%(_bottom),%(_top),--reference=""%(_name)"",--reference=""%(_thresholds)"",--reference=""%(_preferred)""]"
}

OnAnswerAmountSlider : all
{
	_answer = reference0
	_bottom = TOINT(reference1[0])
	_top = TOINT(reference1[1])
	_middle = ((_top - _bottom) / 2) + _bottom
	_name = reference2
	_thresholds = reference3
	_preferred = reference4
	
	_response = DetermineSliderResponse(_answer,_middle,_thresholds)
	
	//MUST return from these if a response is given, otherwise continue down...
	if _name == "something"
	{
		//Custom behavior
	}
	
	if _preferred == ""; SliderAmount.GenericNeutral //None specified
	elseif _preferred == "medium" //separate here otherwise we lose the neutral responses in between
	{
		if _response == "medium"; SliderAmount.GenericPositive
		elseif "very" _in_ _response; SliderAmount.GenericNegative
		else; SliderAmount.GenericNeutral
	}
	else
	{
		if _preferred _in_ _response //high and high, high and very high, low and low, low and very low, medium and medium...
		{
			if ARRAYSIZE(_thresholds) > 2 && "very" _in_ _response; SliderAmount.GenericVeryPositive
			else; SliderAmount.GenericPositive
		}
		elseif _response == "medium"; SliderAmount.GenericNeutral //Medium and high, medium and low...
		else //high and low, high and very low, low and high, low and very high...
		{
			if ARRAYSIZE(_thresholds) > 2 && "very" _in_ _response; SliderAmount.GenericVeryNegative
			else; SliderAmount.GenericNegative
		}
	}
}

