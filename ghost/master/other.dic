DetermineSliderResponse
{
	_answer = _argv[0]
	_middle = TOINT(_argv[1])
	_argv[0] = IARRAY
	_argv[0] = IARRAY
	_thresholds = SPLIT(_argv,",")
	for _i = 0; _i < ARRAYSIZE(_thresholds); _i++
	{
		_thresholds[_i] = TOINT(_thresholds[_i])
	}
	_count = ARRAYSIZE(_thresholds)
	
	_response = "medium"
	if _answer == _middle; _response = "medium" //It's awkward if you don't move the slider at all and the response isn't neutral
	elseif _count == 1
	{
		if _answer > _thresholds[0]; _response = "high"
		else; _response = "low"
	}
	elseif _count == 2
	{
		if _answer > _thresholds[1]; _response = "high"
		elseif _answer > _thresholds[0]; _response = "medium"
		else; _response = "low"
	}
	elseif _count == 3
	{
		if _answer > _thresholds[2]; _response = "very high"
		elseif _answer > _thresholds[1]; _response = "high"
		elseif _answer > _thresholds[0]; _response = "low"
		else; _response = "very low"
	}
	elseif _count == 4
	{
		if _answer > _thresholds[3]; _response = "very high"
		elseif _answer > _thresholds[2]; _response = "high"
		elseif _answer > _thresholds[1]; _response = "medium"
		elseif _answer > _thresholds[0]; _response = "low"
		else; _response = "very low"
	}
	//More than that and you'll have to do it custom
	_response
}

name
{
	_name = TempNames
	if NameDiscovered
	{
		_name = CurrentName
		"\_a[OnQuestionName]%(_name)\_a"
	}
	else; _name
}

OnQuestionName
{
	_index = NameIndex
	if SavedUsername != username //New name
	{
		NameIndex = 7
		SavedUsername = username
		ProgressMangler
		
		"\0\b[0]%(processing)%(paper)Oh? Name changed? %(read)%(paper)Ok! Let me see here, %(squint)%(paper)it's... \n\n... %(read)%(paper)%(CurrentName)! Yes! %(forward)%(neutral)Call you %(CurrentName) from now on. %(happy)%(agitated)Good sound."
	}
	elseif NameIndex > 0
	{
		ProgressMangler
		
		if _index == 1 //Saying it right for the first time
		{
			"\0\b[0]%(processing)%(paper)%(CurrentName)? %(smile)%(neutral)%(CurrentName)! %(happy)%(agitated)%(CurrentName) %(CurrentName) %(CurrentName) %(CurrentName) %(CurrentName)~!!"
		}
		elseif _index == 6
		{
			//"\0\b[4]%(neutral)%(forward)Oh. %(nervous)%(tie)Say name wrong...? %(squint)%(paper)It's... Ah! %(pet)%(neutral)It's %(CurrentName)! %(forward)%(neutral)I get it right now."
			"\0\b[4]%(look)%(paper)What? %(squint)%(paper)What??? %(scowl)%(paper)You say... %(CurrentName)? %(processing)%(paper)Grrm..."
		}
		else //Getting it wrong in a new way
		{
			"\0\b[4]%(processing)%(paper)Oh oh, okay! %(smile)%(neutral)I got it, it's %(CurrentName). %(forward)%(neutral)Yes, sure this time."
		}
	}
	elseif NameIndex == 0 //Already had it right
	{
		"\0\b[4]%(smile)%(paper)Yes yes, I remember, %(CurrentName)! %(happy)%(agitated)%(CurrentName) %(CurrentName) %(CurrentName)~"
	}
	--
	"\_w[2000]"
}

OnNotifyDressupInfo
{
	TiesAvailable = IARRAY
	LightsOn = 1
	// [character ID, category name, part name, option, on-1/off-0, thumbnail path]
	foreach reference; _dressup
	{
		if _dressup[1,C_BYTE1] == "Lights" && _dressup[4,C_BYTE1] == "1"; LightsOn = 0
		if _dressup[1,C_BYTE1] == "Tie"; TiesAvailable ,= _dressup[2,C_BYTE1]
	}
}

